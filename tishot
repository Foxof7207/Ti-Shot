# Capture l'écran d'une TI-Nspire (USB) -> ~/Pictures/ti-AAAAMMJJ-HHMMSS.png
set -e
out="${1:-$HOME/Pictures/ti-$(date +%Y%m%d-%H%M%S).png}"
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
cd "$tmp"
~/.local/share/tishot/shot 2>/dev/null || { echo "Échec: calculatrice branchée et allumée ?" >&2; exit 1; }
python3 -I -c "
from PIL import Image
Image.open('screen.ppm').resize((640,480)).save('$out')"
echo "$out"
